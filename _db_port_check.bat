@echo off
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$o = @(); $o += 'time: ' + (Get-Date -Format s); try { $ips = [System.Net.Dns]::GetHostAddresses('orikio.iptime.org') | ForEach-Object { $_.IPAddressToString }; $o += 'dns: ' + ($ips -join ', ') } catch { $o += 'dns: FAIL ' + $_.Exception.Message }; $c = New-Object System.Net.Sockets.TcpClient; $sw = [Diagnostics.Stopwatch]::StartNew(); try { $ar = $c.BeginConnect('orikio.iptime.org', 1433, $null, $null); if ($ar.AsyncWaitHandle.WaitOne(8000)) { $c.EndConnect($ar); $o += 'tcp1433: OPEN (' + $sw.ElapsedMilliseconds + 'ms)' } else { $o += 'tcp1433: TIMEOUT (8s)' } } catch { $o += 'tcp1433: FAIL ' + $_.Exception.InnerException.Message } finally { $c.Close() }; $o | Set-Content -Encoding UTF8 '_db_port_check.txt'"
